# More info: https://docs.docker.com/engine/reference/builder/#dockerignore-file
# Ignore build and test binaries.
bin/
tmp/

# Test data and local dev
testdata/
local/
test/

# Config / manifests (not needed in image)
config/
charts/
dist/

# CI / tooling
.github/
.gitlab/
Makefile*
skaffold.yaml
hack/

# Docs and notes
docs/
*.md

# IDE / editor
.idea/
.vscode/
*.swp

# Git
.git/
.gitignore
.dockerignore
